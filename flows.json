    {
        "id": "san_fn_dino",
        "type": "function",
        "z": "san_tab",
        "name": "score et record",
        "func": "let score, record;\nif (typeof msg.payload === 'object') {\n    score = Number(msg.payload.score);\n    record = Number(msg.payload.record);\n} else {\n    score = Number(msg.payload);\n    record = Math.max(flow.get('dino_record') ?? 0, score);\n    flow.set('dino_record', record);\n}\nif (isNaN(score) || isNaN(record)) return null;\nreturn { payload: 'Dernier score : ' + score + '   |   Record : ' + record };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
