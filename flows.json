    {
        "id": "san_fn_alarme_temp",
        "type": "function",
        "z": "san_tab",
        "name": "Alerte temperature ?",
        "func": "// Alerte température : valeur > seuil (curseur) ET mode SANTE (interrupteur de l'Arduino sur ON)\nconst val = Number(msg.payload);\nif (isNaN(val)) return [null, null];\n\nconst seuil = flow.get('seuil_temp') ?? 37.5;   // regle par le curseur de ce groupe\nconst sante = flow.get('sante') ?? false;          // true = interrupteur ON\n\nlet texte, ordre;\nif (!sante) {\n    texte = '⚪ Alertes désactivées (mode OFFLINE)';\n    ordre = 'off';\n} else if (val <= 0) {\n    texte = '⚪ Pas de mesure';\n    ordre = 'off';\n} else if (val > seuil) {\n    texte = '🚨 ALERTE température : ' + val.toFixed(1) + ' °C > ' + seuil;\n    ordre = 'on';\n} else {\n    texte = '✅ température normal (' + val.toFixed(1) + ' °C)';\n    ordre = 'off';\n}\n\n// Texte : envoye seulement s'il change. Ordre pour l'Arduino : seulement si l'etat change.\nconst sortie = [null, null];\nif (texte !== flow.get('ordre_temp_texte')) { flow.set('ordre_temp_texte', texte); sortie[0] = { payload: texte }; }\nif (ordre !== flow.get('ordre_temp')) { flow.set('ordre_temp', ordre); sortie[1] = { payload: ordre }; }\nreturn sortie;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 710,
        "wires": [
            [
                "san_txt_alarme_temp"
            ],
            [
                "san_out_alarme_temp"
            ]
        ]
    },
    {
        "id": "san_out_alarme_temp",
        "type": "mqtt out",
        "z": "san_tab",
