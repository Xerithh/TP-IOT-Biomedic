    {
        "id": "san_fn_alarme_bpm",
        "type": "function",
        "z": "san_tab",
        "name": "Alerte BPM ?",
        "func": "// Alerte BPM : valeur > seuil (curseur) ET mode SANTE (interrupteur de l'Arduino sur ON)\nconst val = Number(msg.payload);\nif (isNaN(val)) return [null, null];\n\nconst seuil = flow.get('seuil_bpm') ?? 120;   // regle par le curseur de ce groupe\nconst sante = flow.get('sante') ?? false;          // true = interrupteur ON\n\nlet texte, ordre;\nif (!sante) {\n    texte = '⚪ Alertes désactivées (mode OFFLINE)';\n    ordre = 'off';\n} else if (val <= 0) {\n    texte = '⚪ Pas de mesure';\n    ordre = 'off';\n} else if (val > seuil) {\n    texte = '🚨 ALERTE BPM : ' + val.toFixed(0) + ' bpm > ' + seuil;\n    ordre = 'on';\n} else {\n    texte = '✅ BPM normal (' + val.toFixed(0) + ' bpm)';\n    ordre = 'off';\n}\n\n// Texte : envoye seulement s'il change. Ordre pour l'Arduino : seulement si l'etat change.\nconst sortie = [null, null];\nif (texte !== flow.get('ordre_bpm_texte')) { flow.set('ordre_bpm_texte', texte); sortie[0] = { payload: texte }; }\nif (ordre !== flow.get('ordre_bpm')) { flow.set('ordre_bpm', ordre); sortie[1] = { payload: ordre }; }\nreturn sortie;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 480,
        "wires": [
            [
                "san_txt_alarme_bpm"
            ],
            [
                "san_out_alarme_bpm"
            ]
        ]
    },
